    {
      "parameters": {
        "jsCode": "const now=Date.now();\nconst rows=$input.all().map(i=>i.json).filter(r=>String(r.status||'').toLowerCase()==='new'&&String(r.priority||'').toLowerCase()==='high').filter(r=>{const t=Date.parse(r.created_at);if(!t)return false;const age=(now-t)/60000,sla=+r.sla_minutes||15;return age>=sla&&age<sla+15});\nif(!rows.length)return [];\nreturn [{json:{text:'ESCALATION: '+rows.length+' high priority lead(s) still NEW past SLA\\n'+rows.map(r=>r.lead_id+' '+r.type+' '+r.phone).join('\\n')}}];",
        "mode": "runOnceForAllItems"
      },
