    {
      "parameters": {
        "jsCode": "const b=$('Admin Webhook').first().json.body||{};const from=String(b.date_from||''),to=String(b.date_to||from),st=String(b.status||'');\nconst rows=$input.all().map(i=>i.json).filter(r=>r&&r.order_id).filter(r=>{const d=String(r.delivery_date||'').slice(0,10);return (!from||d>=from)&&(!to||d<=to)&&(!st||String(r.status)===st)}).sort((a,c)=>String(c.created_at).localeCompare(String(a.created_at))).slice(0,300);\nreturn [{json:{response:{ok:true,count:rows.length,orders:rows.map(r=>({order_id:r.order_id,created_at:r.created_at,status:r.status,customer_name:r.customer_name,phone:String(r.phone),address:r.address,area:r.area,pincode:r.pincode,slot:r.slot,delivery_date:String(r.delivery_date||'').slice(0,10),items:r.items,items_json:r.items_json,total:+r.total,payment:r.payment,invoice_no:r.invoice_no||'',rider:r.rider||'',notes:r.notes||'',collected_inr:r.collected_inr||''}))}}}];",
        "mode": "runOnceForAllItems"
      },
