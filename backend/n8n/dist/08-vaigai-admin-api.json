    {
      "parameters": {
        "jsCode": "const CATALOG={'VGM-CARTON-500ml':{n:\"Vaigai Fresh milk\",ta:\"வைகை ஃப்ரெஷ் பால்\",u:\"500 ml\",p:32,d:\"Everyday pasteurised milk in a clean, sealed pack.\",tags:[\"milk\", \"fresh\", \"daily\", \"pack\", \"carton\", \"tea\", \"coffee\", \"kids\"]},'VGM-BADAM-250ml':{n:\"Badam milk\",ta:\"பாதாம் பால்\",u:\"250 ml\",p:55,d:\"Roasted almonds and saffron in chilled, creamy milk.\",tags:[\"badam\", \"almond\", \"flavoured\", \"kids\", \"shake\", \"smoothie\"]},'VGM-GHEE-500ml':{n:\"Farm ghee\",ta:\"பண்ணை நெய்\",u:\"500 ml\",p:320,d:\"Golden, grainy and fragrant. Slow-made from fresh cream.\",tags:[\"ghee\", \"nei\", \"sweet\", \"pongal\", \"festival\", \"rice\"]},'VGM-CURD-400g':{n:\"Set curd\",ta:\"கெட்டித் தயிர்\",u:\"400 g\",p:60,d:\"Set in a clay pot the traditional way. Thick and cool.\",tags:[\"curd\", \"thayir\", \"yogurt\", \"dahi\", \"breakfast\", \"idli\", \"dosa\", \"lunch\"]},'VGM-BUTTER-200g':{n:\"Fresh butter\",ta:\"புதிய வெண்ணெய்\",u:\"200 g\",p:110,d:\"Cold, creamy and just salty enough.\",tags:[\"butter\", \"vennai\", \"idli\", \"dosa\", \"bread\"]},'VGM-HERO-500ml':{n:\"Glass bottle milk\",ta:\"கண்ணாடி பாட்டில் பால்\",u:\"500 ml\",p:36,d:\"Full cream milk in returnable glass. Pure and simple.\",tags:[\"milk\", \"glass\", \"bottle\", \"returnable\", \"coffee\", \"tea\", \"full cream\"]}};\nconst b=$('Admin Webhook').first().json.body||{};const OK=['received','confirmed','out_for_delivery','delivered','cancelled','needs_review','failed'];const clean=s=>String(s==null?'':s).replace(/[\\u0000-\\u001f]/g,' ').trim();const safe=s=>/^[=+\\-@]/.test(s)?\"'\"+s:s;\nconst id=clean(b.order_id).toUpperCase().slice(0,30),status=clean(b.status);\nif(!id||OK.indexOf(status)<0)return [{json:{ok:false,response:{ok:false,error:'valid order id and status required'}}}];\nconst upd={order_id:id,status,rider:safe(clean(b.rider).slice(0,40)),notes:safe(clean(b.notes).slice(0,300)),delivered_at:status==='delivered'?new Date().toISOString():'',collected_inr:status==='delivered'&&b.collected_inr!==undefined?String(Math.max(0,Math.min(100000,Math.round(+b.collected_inr||0)))):''};\nreturn [{json:{ok:true,upd,response:{ok:true,order_id:id,status}}}];",
        "mode": "runOnceForAllItems"
      },
